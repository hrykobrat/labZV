# Вводим стороны прямоугольника
a: float = float(input("Введите длину стороны a: "))
b: float = float(input("Введите длину стороны b: "))

# Вычисляем площадь и периметр
area: float = a * b
perimeter: float = 2 * (a + b)

# Выводим результат с пояснениями
print(f"Площадь прямоугольника: {area:.2f}")
print(f"Периметр прямоугольника: {perimeter:.2f}")
