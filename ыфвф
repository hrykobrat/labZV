# Ввод года с клавиатуры
year: int = int(input("Введите год: "))

# Проверка условия високосного года
if year <= 0:
    print("Ошибка: год должен быть положительным числом.")
elif (year % 4 == 0 and year % 100 != 0) or (year % 400 == 0):
    print(f"Год {year} — високосный. Количество дней: 366.")
else:
    print(f"Год {year} — невисокосный. Количество дней: 365.")
